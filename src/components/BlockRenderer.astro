---
import { componentMap } from '~/cloudcannon/componentMap';

interface Props {
  block: Record<string, unknown> & { _type?: string };
}

const { block } = Astro.props;
const { _type, ...props } = block;
const Component = (_type ? componentMap[_type] : undefined) as
  | ((_props: Record<string, unknown>) => unknown)
  | undefined;
---

{Component && <Component {...props} />}
